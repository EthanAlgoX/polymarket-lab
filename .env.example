PMS_HOST=127.0.0.1
PMS_PORT=8000
PMS_ENABLE_LIVE_SCANNER=true
PMS_MAX_MARKETS=40
PMS_MINIMUM_LIQUIDITY=1000
PMS_DEFAULT_QUANTITY=10
PMS_LOG_LEVEL=INFO

# English is the default and needs no LLM API. Chinese requires your own key.
# Configure Translation API in the local website's Settings (no restart),
# or use these backend DeepSeek environment values and restart the server.
# Website settings override these values in ignored data/llm-config.json.
# Keep all credentials private; never commit .env or local runtime data.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
