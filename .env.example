PMS_HOST=127.0.0.1
PMS_PORT=8000
PMS_ENABLE_LIVE_SCANNER=true
PMS_MAX_MARKETS=40
PMS_MINIMUM_LIQUIDITY=1000
PMS_DEFAULT_QUANTITY=10
PMS_LOG_LEVEL=INFO

# Optional: translate public market text on the backend with DeepSeek.
# Keep credentials in the process environment or an ignored local .env.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
