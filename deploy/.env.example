PMS_IMAGE=polymarket-lab:latest
PMS_SERVER_PORT=8011
PMS_ROOT_PATH=/polymarket-lab
PMS_DATA_DIR=/opt/polymarket-lab/data
PMS_LOG_DIR=/opt/polymarket-lab/logs
# Enable only behind an authenticated HTTPS reverse proxy.
PMS_CONFIGURATION_ORIGIN=https://example.com
# Optional backend translation credential; otherwise configure in Settings.
DEEPSEEK_API_KEY=
