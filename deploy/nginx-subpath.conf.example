# Include inside an existing HTTPS server block. Replace example.com and
# password-file path with your authenticated site's configuration.
location = /polymarket-lab {
    return 308 /polymarket-lab/;
}
location ^~ /polymarket-lab/ {
    auth_basic "Polymarket Lab Workspace";
    auth_basic_user_file /etc/nginx/polymarket-lab.htpasswd;
    if ($http_origin !~ "^(https://example[.]com)?$") { return 403; }
    proxy_pass http://127.0.0.1:8011/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Authorization "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;
    client_max_body_size 128k;
    gzip on;
    gzip_types application/javascript application/json text/css;
    gzip_min_length 1024;
    gzip_vary on;
}
